    {
      "parameters": {
        "jsCode": "const videoUrl = $node[\"cloudnarydownloadvideo\"].json[\"secure_url\"];\n\n// choose timestamps\nconst times = [5, 12, 18,23,28];\n\n// create and combine frame URLs\nconst frameUrls = times.map(t => {\n  let baseUrl = videoUrl.replace(\".mp4\", \"\");\n  return baseUrl.replace(\"/upload/\", `/upload/so_${t}/`) + \".jpg\";\n});\n\n// return ONLY combined screenshots\nreturn [\n  {\n    json: {\n      frame_urls: frameUrls\n    }\n  }\n];"
      },
